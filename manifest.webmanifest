{
  "name": "Wellness Hub",
  "short_name": "Wellness",
  "description": "Whole-body health tracking — fitness, mobility, eye care, dental, body care, daily wellness and health records. Offline, private, no account.",
  "id": "/wellness-hub",
  "start_url": ".",
  "scope": ".",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#1d2021",
  "theme_color": "#1d2021",
  "categories": ["health", "fitness", "lifestyle", "productivity"],
  "lang": "en",
  "dir": "ltr",

  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],

  "shortcuts": [
    {
      "name": "Log water",
      "short_name": "Water",
      "description": "Jump straight to hydration",
      "url": "./?go=wellness&pill=hydration",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Brushing timer",
      "short_name": "Brush",
      "description": "Two-minute quadrant timer",
      "url": "./?go=dental&action=brush",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Stand break",
      "short_name": "Stand",
      "description": "A two-minute movement snack away from the desk",
      "url": "./?go=desk&action=stand",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Mobility routine",
      "short_name": "Mobility",
      "description": "Guided joint routines",
      "url": "./?go=mobility",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Mood check-in",
      "short_name": "Mood",
      "description": "Log mood, energy and stress",
      "url": "./?go=wellness&pill=mood",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }]
    }
  ]
}
