# Tauri build output and generated files — never committed.
src-tauri/target/
src-tauri/gen/schemas/
# gen/android is committed: it carries the manifest permissions and signing
# config (PLAN-android.md B2). Its own .gitignore drops build output.
src-tauri/icons/
src-tauri/dist/

# Local secrets: Supabase URL + anon key live here, out of the repo.
# The app reads them at build time (PLAN-desktop-supabase.md B2).
src-tauri/.env

# A stray nested checkout of this same repo — not a deploy target, not a
# submodule. Never commit it; it'd create a broken gitlink.
deploy/

# Generated by the vendored plugin's build.rs on every build.
src-tauri/plugins/notification/android/.tauri/
src-tauri/plugins/notification/android/build/
