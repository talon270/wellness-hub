      "<rect width='24' height='24' rx='5' fill='#282828'/>" +
      "<path d='M12 20s-6.5-4.3-6.5-9A3.8 3.8 0 0 1 12 8.4 3.8 3.8 0 0 1 18.5 11c0 4.7-6.5 9-6.5 9z' " +
